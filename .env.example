# Copy values into your local environment; never commit .env files.
DATABASE_URL=postgresql+psycopg2://pricepulse:change-me@localhost:5432/pricepulse
SECRET_KEY=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT=180
OLLAMA_IDENTITY_TIMEOUT=180
OLLAMA_RELEVANCE_TIMEOUT=45
OLLAMA_STRATEGIST_TIMEOUT=180
# Set this to a durable mounted volume path in production.
CHROMA_PERSIST_DIRECTORY=./chroma_db
# Optional SMTP: SMTP_HOST, SMTP_PORT, SMTP_USERNAME, SMTP_PASSWORD, SMTP_FROM_EMAIL
# Optional frontend build API URL: VITE_API_URL=http://localhost:8000
# Set VITE_API_URL in Vercel to the hosted FastAPI HTTPS origin (public value).
