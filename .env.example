# Copy this file to backend/.env for direct local backend runs, or to the
# repository-root .env for Docker Compose. Replace local placeholders before use.
# Never commit populated .env files or copy deployment secrets into VITE_* values.
POSTGRES_DB=pricepulse
POSTGRES_USER=pricepulse
POSTGRES_PASSWORD=replace-with-a-local-only-password
DATABASE_URL=postgresql+psycopg2://pricepulse:replace-with-a-local-only-password@localhost:5432/pricepulse
SECRET_KEY=replace-with-a-long-random-local-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173

# Local Ollama service. Pull qwen3:8b separately with `ollama pull qwen3:8b`.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT=180
OLLAMA_IDENTITY_TIMEOUT=180
OLLAMA_RELEVANCE_TIMEOUT=45
OLLAMA_STRATEGIST_TIMEOUT=180

# ChromaDB local data directory; use a durable mounted path in deployments.
CHROMA_PERSIST_DIRECTORY=./chroma_db

# Scraping limits and per-marketplace switches.
SCRAPE_FRESHNESS_THRESHOLD_DAYS=7
MAX_DETAIL_PRODUCTS=10
PLAYWRIGHT_TIMEOUT=30000
SCRAPE_DELAY_MS=1500
MARKETPLACE_TIMEOUT_SECONDS=25
AMAZON_MARKETPLACE_TIMEOUT_SECONDS=180
SCRAPER_DEBUG=false
SCRAPER_AMAZON_ENABLED=true
SCRAPER_FLIPKART_ENABLED=true
SCRAPER_MYNTRA_ENABLED=true
SCRAPER_MEESHO_ENABLED=true

# Optional SMTP password reset delivery. Configure all fields to enable it.
SMTP_HOST=
SMTP_USE_SSL=false
SMTP_USE_TLS=true
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Frontend build-time public API base URL.
VITE_API_URL=http://localhost:8000
